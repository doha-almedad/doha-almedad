
/* Profile Page */
.profile-header {
    background: white;
    padding: 25px;
    border-radius: var(--radius);
    margin-bottom: 25px;
    display: flex;
    align-items: center;
    gap: 20px;
    box-shadow: var(--shadow);
}

.profile-avatar {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background-color: var(--secondary-color);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    color: white;
}

.streak-banner {
    background: linear-gradient(135deg, #ff9f43, #ff5252);
    color: white;
    padding: 15px 20px;
    border-radius: var(--radius);
    margin-bottom: 25px;
    font-weight: bold;
}

/* Admin Dashboard */
.admin-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 20px;
}

.admin-table th, .admin-table td {
    padding: 12px;
    border: 1px solid var(--border-color);
    text-align: right;
}

.admin-table th {
    background-color: var(--primary-color);
    color: white;
}
