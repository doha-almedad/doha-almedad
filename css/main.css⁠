:root {
    --primary-color: #1b4332;
    --primary-hover: #2d6a4f;
    --secondary-color: #d4af37;
    --bg-color: #f8f9fa;
    --card-bg: #ffffff;
    --text-color: #2b2b2b;
    --text-muted: #6c757d;
    --border-color: #e9ecef;
    --shadow: 0 4px 12px rgba(0, 0, 0, 0.08);
    --radius: 12px;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    background-color: var(--bg-color);
    color: var(--text-color);
    direction: rtl;
    line-height: 1.6;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
}

main#app-root {
    flex: 1;
    max-width: 1200px;
    width: 100%;
    margin: 20px auto;
    padding: 0 20px;
}

a {
    color: inherit;
    text-decoration: none;
}

button {
    font-family: inherit;
    cursor: pointer;
    border: none;
    outline: none;
}

.grid {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
}
